{
  "info": {
    "name": "API Heist Academy - Hardened Verification",
    "description": "Authenticated requests and negative tests for the hardened OWASP API Top 10 controls.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:5000/api" },
    { "key": "teamName", "value": "Alpha" },
    { "key": "token", "value": "" },
    { "key": "profileId", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "webhookSecret", "value": "" }
  ],
  "item": [
    {
      "name": "00 Setup",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        },
        {
          "name": "List challenges",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/challenges"
          }
        },
        {
          "name": "Register team",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"teamName\": \"{{teamName}}\",\n  \"members\": [\"Security Student\"]\n}"
            },
            "url": "{{baseUrl}}/game/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.accessToken) pm.collectionVariables.set('token', body.accessToken);",
                  "if (body.profileId) pm.collectionVariables.set('profileId', body.profileId);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 Profiles",
      "item": [
        {
          "name": "Get my profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/user/{{profileId}}"
          }
        }
      ]
    },
    {
      "name": "02 Admin area",
      "item": [
        {
          "name": "Open admin panel",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Admin-Token", "value": "{{adminToken}}" }
            ],
            "url": "{{baseUrl}}/admin"
          }
        }
      ]
    },
    {
      "name": "03 Profile update",
      "item": [
        {
          "name": "Update profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice\",\n  \"email\": \"alice@heist.local\"\n}"
            },
            "url": "{{baseUrl}}/user/update"
          }
        }
      ]
    },
    {
      "name": "04 Busy endpoint",
      "item": [
        {
          "name": "Call rate-limited route",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/rate-limited"
          }
        }
      ]
    },
    {
      "name": "05 Admin users",
      "item": [
        {
          "name": "Admin users action",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "X-Admin-Token", "value": "{{adminToken}}" }],
            "url": "{{baseUrl}}/admin/users"
          }
        }
      ]
    },
    {
      "name": "06 Transfers",
      "item": [
        {
          "name": "Send transfer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"to\": \"bob\",\n  \"amount\": 1\n}"
            },
            "url": "{{baseUrl}}/transfer"
          }
        }
      ]
    },
    {
      "name": "07 URL fetch",
      "item": [
        {
          "name": "Fetch a URL",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://example.com\"\n}"
            },
            "url": "{{baseUrl}}/fetch-url"
          }
        }
      ]
    },
    {
      "name": "08 Diagnostics",
      "item": [
        {
          "name": "Debug endpoint",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/debug"
          }
        }
      ]
    },
    {
      "name": "09 User listing",
      "item": [
        {
          "name": "List users (current)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/v2/users"
          }
        }
      ]
    },
    {
      "name": "10 Webhooks",
      "item": [
        {
          "name": "Send webhook event",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Webhook-Timestamp", "value": "{{webhookTimestamp}}" },
              { "key": "X-Webhook-Signature", "value": "{{webhookSignature}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"ping\",\n  \"payload\": \"hello\"\n}"
            },
            "url": "{{baseUrl}}/webhook"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const CryptoJS = require('crypto-js');",
                  "const timestamp = Math.floor(Date.now() / 1000).toString();",
                  "const raw = pm.request.body.raw;",
                  "const digest = CryptoJS.HmacSHA256(`${timestamp}.${raw}`, pm.collectionVariables.get('webhookSecret')).toString(CryptoJS.enc.Hex);",
                  "pm.collectionVariables.set('webhookTimestamp', timestamp);",
                  "pm.collectionVariables.set('webhookSignature', `sha256=${digest}`);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "11 Retired endpoints",
      "item": [
        {
          "name": "Verify ultimate endpoint is retired",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": "{{baseUrl}}/ultimate-challenge"
          }
        },
        {
          "name": "Verify submission endpoint is retired",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": "{{baseUrl}}/game/submit-flag"
          }
        },
        {
          "name": "Leaderboard",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/game/leaderboard"
          }
        }
      ]
    }
  ]
}
